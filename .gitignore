# Synced reference material and local working artifacts
sources/
tmp/
doc_review_render/
__pycache__/
*.pyc

# FreeCAD recovery and editor files
*.FCStd1
*.bak
*.swp

# OpenFOAM generated runtime data
openfoam/**/processor*/

# OpenFOAM post-processing:
# ignore generated data by default, but preserve force coefficients

openfoam/**/postProcessing/*
!openfoam/**/postProcessing/forceCoeffs/
!openfoam/**/postProcessing/forceCoeffs/**
openfoam/**/logs/
openfoam/**/log.*

# Operating-system metadata
Thumbs.db
.DS_Store

# ============================================================
# Obsidian - local state and private plugin settings
# ============================================================

# Local UI state - machine specific
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian trash
.trash/

# Plugin local settings may contain API keys/tokens
.obsidian/plugins/*/data.json

# Temporary backups created during UTF-8 repair
docs/**/*.utf8-backup


# ============================================================
# Python environments and caches
# ============================================================

.venv/
venv/
.pytest_cache/
.mypy_cache/


# ============================================================
# OpenFOAM additional generated data
# ============================================================

# ParaView / exported visualization data
openfoam/**/VTK/

# OpenFOAM/ParaView placeholder files
openfoam/**/*.foam